{
  "name": "picopix",
  "version": "0.1.0",
  "description": "Tiny, typed, tree-shakeable image processing for the browser and Node.",
  "keywords": [
    "image",
    "resize",
    "crop",
    "rotate",
    "exif",
    "compress",
    "webp",
    "avif",
    "canvas",
    "web-worker",
    "tree-shakeable",
    "typescript",
    "background-removal",
    "upscale",
    "image-processing",
    "browser",
    "pixel",
    "offscreen-canvas",
    "napi-rs",
    "tiny"
  ],
  "license": "MIT",
  "author": "Zahid Hasan",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pixels": {
      "import": {
        "types": "./dist/pixels.d.ts",
        "default": "./dist/pixels.js"
      },
      "require": {
        "types": "./dist/pixels.d.cts",
        "default": "./dist/pixels.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      },
      "require": {
        "types": "./dist/worker.d.cts",
        "default": "./dist/worker.cjs"
      }
    },
    "./providers/imgly": {
      "import": {
        "types": "./dist/providers/imgly.d.ts",
        "default": "./dist/providers/imgly.js"
      },
      "require": {
        "types": "./dist/providers/imgly.d.cts",
        "default": "./dist/providers/imgly.cjs"
      }
    },
    "./providers/transformers": {
      "import": {
        "types": "./dist/providers/transformers.d.ts",
        "default": "./dist/providers/transformers.js"
      },
      "require": {
        "types": "./dist/providers/transformers.d.cts",
        "default": "./dist/providers/transformers.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "pixels": [
        "./dist/pixels.d.ts"
      ],
      "node": [
        "./dist/node.d.ts"
      ],
      "worker": [
        "./dist/worker.d.ts"
      ],
      "providers/imgly": [
        "./dist/providers/imgly.d.ts"
      ],
      "providers/transformers": [
        "./dist/providers/transformers.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"for (const d of ['dist','coverage','.bench']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-test.mjs",
    "bench": "tsx scripts/bench.ts",
    "size": "tsx scripts/size.ts",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.0.0",
    "@imgly/background-removal": ">=1.4.0",
    "@napi-rs/canvas": ">=0.1.40"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "@imgly/background-removal": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
